# ── Admin console ──────────────────────────────────────────────────────────
# Console password — change before deploying.
ADMIN_PASSWORD="change-me-before-launch"

# Public deployment: "false" so /admin 404s.
# Console deployment: "true".
ADMIN_ENABLED="true"

# ── Database ───────────────────────────────────────────────────────────────
# Postgres (Neon, Vercel Postgres, Supabase, …). Use the pooled connection
# string on serverless. Tables + seed catalogue are created on first request;
# `npm run db:migrate` applies them explicitly.
# DATABASE_URL="postgres://user:pass@host-pooler.region.aws.neon.tech/db?sslmode=require"
# POSTGRES_URL is also read, for Vercel/Neon integrations that inject it.

# Connections per serverless instance (default 3).
# DATABASE_POOL_MAX="3"

# Optional: local SQL without installing Postgres. Dev/test only.
# DB_DRIVER="pglite"
# PGLITE_PATH=".data/pg"
